# ── Server ───────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────
DATABASE_URL=file:./data/nexgate.db
# Master key để mã hoá upstream api keys (AES-256-GCM). 32 bytes base64.
# Sinh: openssl rand -base64 32
DB_MASTER_KEY=

# ── Admin (Dashboard) ────────────────────────────────────
ADMIN_USERNAME=admin
# Sinh bcrypt hash: node -e "console.log(require('bcryptjs').hashSync('yourpass',10))"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# ── Upstream mặc định (chỉ dùng trong seed nếu chưa có provider nào) ──
UPSTREAM_BASE_URL=https://xxx.com/v1
UPSTREAM_API_KEY=sk-...

# ── Security / Limits ────────────────────────────────────
RATE_LIMIT_DEFAULT=60
CONCURRENCY_LIMIT=5
MAX_BODY_SIZE_MB=32
UPSTREAM_CONNECT_TIMEOUT_MS=10000
UPSTREAM_READ_TIMEOUT_MS=120000
